; sudo ln -s ~/.dotfiles/services/wsl-mount.service /usr/lib/systemd/system/wsl-mount.service
; sudo systemctl enable wsl-mount.service

[Unit]
Description=Mount SMB Shares
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
# SMB 凭据从 /etc/smbcredentials 读取,不在单元文件里写明文密码。
# 部署时创建该文件(root 所有、权限 600),内容示例:
#   username=admin
#   password=<your-password>
ExecStart=/bin/mount -t cifs -o credentials=/etc/smbcredentials,rw,uid=1000,gid=1000 //192.168.1.10/st2000 /mnt/st2000
ExecStart=/bin/mount -t cifs -o credentials=/etc/smbcredentials,rw,uid=1000,gid=1000 //192.168.1.10/mg08 /mnt/mg08
ExecStart=/bin/mount -t cifs -o credentials=/etc/smbcredentials,rw,uid=1000,gid=1000 //192.168.1.10/share /mnt/share
ExecStop=/bin/umount /mnt/st2000
ExecStop=/bin/umount /mnt/mg08
ExecStop=/bin/umount /mnt/share

[Install]
WantedBy=multi-user.target
